  "description": "FilingPulse Cloudflare Workers API with Hono + @x402/hono (USDC on Base) + Stripe API key rail",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
