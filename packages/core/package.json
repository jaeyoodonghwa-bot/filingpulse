{
  "name": "@filingpulse/core",
  "version": "1.0.0",
  "description": "Pure TypeScript deterministic SEC EDGAR 8-K & Form 4 signal engine (Workers, Node, Browser)",
  "type": "module",
  "main": "./dist/index.js",
